rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and RBAC
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.get('role', '') == 'admin' ||
        (request.auth.token.get('email_verified', false) &&
         request.auth.token.get('email', '') == 'sivasyam05@gmail.com'));
    }

    function isReviewer() {
      return isSignedIn() && (isAdmin() || request.auth.token.get('role', '') == 'reviewer');
    }
    // USERS COLLECTION
    // Users can read/write their own user record; admins can view all users for auditing
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.uid == userId &&
        request.resource.data.keys().hasAll(['email', 'createdAt']) &&
        (request.resource.data.role == 'user' || isAdmin());
      allow update: if isAdmin() || (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'role', 'createdAt']));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // CASES COLLECTION
    // Anonymous clinical cases created by clinicians/students (Strict UID isolation, deny by default)
    match /cases/{caseId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isReviewer());
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.caseId is string &&
        request.resource.data.engineVersion is string;
      allow update: if isOwner(resource.data.ownerUid) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // DRUGS COLLECTION
    // Read-only for authenticated users; write-restricted to system administrators
    match /drugs/{drugId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // FEEDBACK COLLECTION
    // Clinician evaluations and guideline dispute notes
    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isReviewer());
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    // AUDIT LOGS COLLECTION
    // Strictly append-only activity trail of simulations executed (no modification or deletion allowed)
    match /auditLogs/{logId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false; // Append-only audit integrity
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
